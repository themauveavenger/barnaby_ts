<h3>Edit Memory</h3>

<p><a href="{{{returnUrl}}}">← Back to Memories</a></p>

<p id="error-msg" style="color: red; display: none;"></p>

<form id="edit-form">
  <label for="content">Content:</label>
  <textarea id="content" name="content" required maxlength="2000">{{content}}</textarea>

  <p>Category: <strong>{{categoryLabel}}</strong></p>

  <p>Permanent: <strong>{{#if permanent}}Yes{{else}}No{{/if}}</strong></p>

  <label for="tags">Tags:</label>
  <input id="tags" type="text" name="tags" value="{{tags}}" placeholder="comma-separated">

  <div>
    <button type="submit" id="save-btn">Save</button>
    <button type="button" id="delete-btn">🗑️ Delete</button>
    <a href="{{{returnUrl}}}">Cancel</a>
  </div>
</form>

<script>
const form = document.getElementById('edit-form');
const deleteBtn = document.getElementById('delete-btn');
const errorMsg = document.getElementById('error-msg');
const id = '{{id}}';

form.addEventListener('submit', async (e) => {
  e.preventDefault();
  errorMsg.style.display = 'none';
  try {
    const res = await fetch(`/memories/${id}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({
        content: document.getElementById('content').value,
        tags: document.getElementById('tags').value.split(',').map(t => t.trim()).filter(Boolean)
      })
    });
    if (res.ok) {
      window.location.href = '{{{returnUrl}}}#memory-' + id;
    } else {
      const body = await res.json();
      errorMsg.textContent = body.message || 'Update failed';
      errorMsg.style.display = 'block';
    }
  } catch (err) {
    errorMsg.textContent = 'Network error';
    errorMsg.style.display = 'block';
  }
});

deleteBtn.addEventListener('click', async () => {
  errorMsg.style.display = 'none';
  try {
    const res = await fetch(`/memories/${id}`, {
      method: 'DELETE',
      credentials: 'same-origin'
    });
    if (res.ok) {
      window.location.href = '{{{returnUrl}}}';
    } else {
      const body = await res.json();
      errorMsg.textContent = body.message || 'Delete failed';
      errorMsg.style.display = 'block';
    }
  } catch (err) {
    errorMsg.textContent = 'Network error';
    errorMsg.style.display = 'block';
  }
});
</script>