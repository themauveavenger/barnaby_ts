PORT=3000
DATABASE_PATH=./barnaby.db
BASIC_AUTH_USERNAME=barnaby
BASIC_AUTH_PASSWORD=change-me
CONTEXT_WINDOW_DAYS=30
OPENCODE_API_KEY=your-opencode-api-key
# Optional: agent provider/model selection (defaults shown). Changing these requires an application restart.
AGENT_PROVIDER=opencode-go
AGENT_MODEL=kimi-k2.6
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
CALENDAR_IDS=your-email@gmail.com,family@group.calendar.google.com
YNAB_ACCESS_TOKEN=personal_access_token
# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
# Cron schedule for daily briefings (e.g., "0 8 * * *" for 8 AM daily)
BRIEFING_CRON='0 8 * * *'
# Cron schedule for afternoon updates (e.g., "0 14 * * *" for 2 PM daily)
# Omit to disable afternoon updates.
AFTERNOON_UPDATE_CRON='0 14 * * *'
# Optional: timeout for manual briefing generation in milliseconds (default: 60000)
# BRIEFING_TIMEOUT_MS=60000
# Optional: timeout for manual afternoon update generation in milliseconds (default: 60000)
# AFTERNOON_TIMEOUT_MS=60000
# Optional: IANA timezone for date ranges and event formatting (default: America/New_York)
# TIMEZONE=America/New_York

# Weather location for daily briefing (latitude and longitude)
# Example: New Jersey, USA
WEATHER_LATITUDE=40.0583
WEATHER_LONGITUDE=-74.4057
# Wolfram|Alpha LLM API AppID
# Get one at https://products.wolframalpha.com/llm-api/
WOLFRAM_ALPHA_APPID=your-wolfram-app-id
# Kagi Search API key for web search and page extraction
# Get one at https://kagi.com/api/keys
KAGI_API_KEY=your-kagi-api-key