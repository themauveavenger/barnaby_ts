PORT=3000
DATABASE_PATH=./barnaby.db
BASIC_AUTH_USERNAME=barnaby
BASIC_AUTH_PASSWORD=change-me
CONTEXT_WINDOW_DAYS=30
OPENCODE_API_KEY=your-opencode-api-key
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
CALENDAR_IDS=your-email@gmail.com,family@group.calendar.google.com
YNAB_ACCESS_TOKEN=personal_access_token
# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
# Cron schedule for daily briefings (e.g., "0 8 * * *" for 8 AM daily)
BRIEFING_CRON='0 8 * * *'
# Optional: timeout for manual briefing generation in milliseconds (default: 60000)
# BRIEFING_TIMEOUT_MS=60000
# Optional: IANA timezone for date ranges and event formatting (default: America/New_York)
# TIMEZONE=America/New_York

# Weather location for daily briefing (latitude and longitude)
# Example: New Jersey, USA
WEATHER_LATITUDE=40.0583
WEATHER_LONGITUDE=-74.4057